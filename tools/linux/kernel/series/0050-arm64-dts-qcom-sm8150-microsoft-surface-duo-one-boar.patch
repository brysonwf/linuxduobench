+++ /dev/null
@@ -1,12 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Surface Duo 1: run PM8150 L17A (vpnl of the R2 panel on DSI1 = the camera-side screen) at 3.0 V like Microsoft's
- * downstream kernel (Droidian regulator dump 2026-11-05: pm8150_l17 enabled 3000000 uV, consumer
- * soc:qcom,dsi-display-secondary-vpnl). The mainline Duo DT allows 2856000..3008000 and the regulator core settles on
- * the minimum (2.856 V); that panel's FIRST init fails on most boots (docs/research/33 "Boot panel fault").
- */
-
-&vreg_l17a_3p0 {
-	regulator-min-microvolt = <3000000>;
-	regulator-max-microvolt = <3008000>;
-};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi
