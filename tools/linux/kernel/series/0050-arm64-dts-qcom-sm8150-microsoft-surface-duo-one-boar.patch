--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi
+++ /dev/null
@@ -1,74 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Surface Duo 1: Venus video codec (IRIS1) for the venus driver patched by patches/venus-sm8150-iris1.py
- * (docs/research/33 "VENUS PORT SPEC"). Placement, clocks, resets and the IOMMU stream come from the phone's own
- * downstream DT (qcom,vidc@aa00000, "qcom,sm8150-vidc"); the node layout follows mainline's sm8250 venus.
- * Firmware: the phone's own modem_a image/venus.mdt, linked at boot to /lib/firmware/qcom/sm8150/microsoft/ by init.
- * Test only via a one-shot DTB (build-test-dtb.sh) with venus as a module loaded by hand.
- */
-#include <dt-bindings/clock/qcom,gcc-sm8150.h>
-#include <dt-bindings/clock/qcom,videocc-sm8150.h>
-#include <dt-bindings/interconnect/qcom,sm8150.h>
-#include <dt-bindings/power/qcom-rpmpd.h>
-
-&{/soc@0} {
-	venus: video-codec@aa00000 {
-		compatible = "qcom,sm8150-venus";
-		reg = <0 0x0aa00000 0 0x100000>;
-		interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
-
-		power-domains = <&videocc VENUS_GDSC>,
-				<&videocc VCODEC0_GDSC>,
-				<&rpmhpd SM8150_MX>;
-		power-domain-names = "venus", "vcodec0", "mx";
-		operating-points-v2 = <&duo_venus_opp_table>;
-
-		clocks = <&gcc GCC_VIDEO_AXI0_CLK>,
-			 <&videocc VIDEO_CC_MVSC_CORE_CLK>,
-			 <&videocc VIDEO_CC_MVS0_CORE_CLK>,
-			 <&gcc GCC_VIDEO_AXIC_CLK>,
-			 <&gcc GCC_VIDEO_AXI1_CLK>;
-		clock-names = "iface", "core", "vcodec0_core", "axic", "axi1";
-
-		interconnects = <&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_VENUS_CFG 0>,
-				<&mmss_noc MASTER_VIDEO_P0 0 &mc_virt SLAVE_EBI_CH0 0>;
-		interconnect-names = "cpu-cfg", "video-mem";
-
-		/* ONE stream only: downstream's mask 0x60 (0x2300/20/40/60) hard-hung the boot as soon as the SMMU registered
-		 * (2026-11-04) - an SMR overlapping streams the hypervisor/TZ owns; 0x2300 alone boots (iommu group 10) */
-		iommus = <&apps_smmu 0x2300 0x0>;
-		memory-region = <&venus_mem>;
-
-		resets = <&gcc GCC_VIDEO_AXIC_CLK_BCR>,
-			 <&videocc VIDEO_CC_MVSC_CORE_CLK_BCR>;
-		reset-names = "bus", "core";
-
-		firmware-name = "qcom/sm8150/microsoft/venus.mdt";
-
-		duo_venus_opp_table: opp-table {
-			compatible = "operating-points-v2";
-
-			opp-240000000 {
-				opp-hz = /bits/ 64 <240000000>;
-				required-opps = <&rpmhpd_opp_low_svs>;
-			};
-			opp-338000000 {
-				opp-hz = /bits/ 64 <338000000>;
-				required-opps = <&rpmhpd_opp_svs>;
-			};
-			opp-365000000 {
-				opp-hz = /bits/ 64 <365000000>;
-				required-opps = <&rpmhpd_opp_svs_l1>;
-			};
-			opp-444000000 {
-				opp-hz = /bits/ 64 <444000000>;
-				required-opps = <&rpmhpd_opp_nom>;
-			};
-			opp-533000000 {
-				opp-hz = /bits/ 64 <533000000>;
-				required-opps = <&rpmhpd_opp_turbo>;
-			};
-		};
-
-	};
-};
