index 5ad504db4..000000000
--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss-noiommu.dtsi
+++ /dev/null
@@ -1,11 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Camera test override (step 9, docs/research/33 "CAMERA"): CAMSS without iommus. The VFE completes frames but its
- * writes never land with the downstream ife bank (0x840 mask 0x620) mapped. Without the mapping the buffers get
- * physical addresses: either the writes now land (stream passed through), or the SMMU reports a fault that names the
- * real VFE stream IDs. Test only.
- */
-
-&duo_camss {
-	/delete-property/ iommus;
-};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-flash.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-flash.dtsi
new file mode 100644
index 000000000..0c764090e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-flash.dtsi
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: the camera's High CRI LED flash on the PM8150L flash LED module (2026-11-05; was an fdtoverlay,
+ * duo-flash-overlay.dts, folded into the board DT 2026-11-07). Values from the phone's own Android DT (dtbo overlay dt31
+ * = DV_A): rear camera-flash -> flash_0 (id 0, max 1200 mA, 1280 ms) + torch_0 (id 0, 135 mA). Mainline channels count
+ * from 1, so id 0 = led-sources <1>. Flash current 500 mA (Android allows 1200) until the LED is characterised.
+ * Driver: drivers/leds/flash/leds-qcom-flash.c.
+ */
+
+&{/soc@0/spmi@c440000/pmic@5/led-controller@d300} {
+	status = "okay";
+
+	led-0 {
+		function = "flash";
+		color = <0>;		/* LED_COLOR_ID_WHITE */
+		led-sources = <1>;
+		led-max-microamp = <135000>;
+		flash-max-microamp = <500000>;
+		flash-max-timeout-us = <1280000>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi
deleted file mode 100644
index 4b464d87d..000000000
--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi
+++ /dev/null
@@ -1,11 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Camera test override (step 7, docs/research/33 "CAMERA"): downstream gives the IMX351 cam_bob-supply = PM8150L BOB
- * at 3.3 V with "pwm-switch" (PWM mode while the camera runs); the board's vana 2.8 V switch is fed from BOB, which
- * mainline leaves at 3.008 V in AUTO mode. Theory: the pixel array starves (the sensor only sent embedded-data lines).
- */
-
-&vreg_bob {
-	regulator-min-microvolt = <3296000>;
-	regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
-};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
deleted file mode 100644
index 3126c30b0..000000000
--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
+++ /dev/null
@@ -1,73 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Surface Duo (SM8150): IPA v4.1 (modem data path) - DRAFT, TEST DTB ONLY.
- * Needs tools/linux/patches/ipa-v4.1 (compatible "qcom,sm8150-ipa").
- * Values from the phone's downstream DT (qcom,ipa@1e00000, ipa_smmu_ap/uc, smp2p "ipa"
- * entries, pil_ipa_fw_region) mapped onto the mainline sc7180/sdm845 node layout.
- * See docs/research/workbench/ipa-v4.1.md. Firmware: vendor_a /firmware/ipa_fws.*,
- * linked at boot to /lib/firmware/qcom/sm8150/ (never stored in the repo).
- */
-
-&{/smp2p-mpss} {
-	ipa_smp2p_out: ipa-ap-to-modem {
-		qcom,entry-name = "ipa";
-		#qcom,smem-state-cells = <1>;
-	};
-
-	ipa_smp2p_in: ipa-modem-to-ap {
-		qcom,entry-name = "ipa";
-		interrupt-controller;
-		#interrupt-cells = <2>;
-	};
-};
-
-&soc {
-	ipa: ipa@1e40000 {
-		compatible = "qcom,sm8150-ipa";
-
-		/* downstream ipa_smmu_ap (0x520) + ipa_smmu_uc (0x522) */
-		iommus = <&apps_smmu 0x520 0x0>,
-			 <&apps_smmu 0x522 0x0>;
-		/* ipa-base 0x1e00000 + v4.0 reg offset 0x40000; SRAM direct access at +0x7000;
-		 * layout ends at 0x280 + 0x2800 (ipa_4_1_mem_part), hence 0x3000 */
-		reg = <0 0x01e40000 0 0x7000>,
-		      <0 0x01e47000 0 0x3000>,
-		      <0 0x01e04000 0 0x2c000>;
-		reg-names = "ipa-reg",
-			    "ipa-shared",
-			    "gsi";
-
-		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING>,
-				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
-				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
-				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
-		interrupt-names = "ipa",
-				  "gsi",
-				  "ipa-clock-query",
-				  "ipa-setup-ready";
-
-		clocks = <&rpmhcc RPMH_IPA_CLK>;
-		clock-names = "core";
-
-		interconnects = <&aggre2_noc MASTER_IPA 0 &mc_virt SLAVE_EBI_CH0 0>,
-				<&aggre2_noc MASTER_IPA 0 &system_noc SLAVE_OCIMEM 0>,
-				<&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_IPA_CFG 0>;
-		interconnect-names = "memory",
-				     "imem",
-				     "config";
-
-		qcom,qmp = <&aoss_qmp>;
-
-		qcom,smem-states = <&ipa_smp2p_out 0>,
-				   <&ipa_smp2p_out 1>;
-		qcom,smem-state-names = "ipa-clock-enabled-valid",
-					"ipa-clock-enabled";
-
-		/* TZ PAS 15 authenticates the GSI firmware the AP loads */
-		qcom,gsi-loader = "self";
-		memory-region = <&ipa_fw_mem>;
-		firmware-name = "qcom/sm8150/ipa_fws.mdt";
-
-		status = "okay";
-	};
-};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-l17a-3v0.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-l17a-3v0.dtsi
