diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-audio.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-audio.dtsi
new file mode 100644
index 000000000..1a1ea787c
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-audio.dtsi
@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1 (SM8150, board DV_A) on-device speaker: Slimbus NGD + WCD9340 codec
+ * + ONE WSA8815 smart amp (SpkrLeft) on the codec's SoundWire master + Q6 APR sound card.
+ *
+ * Structure ported from mainline sdm845.dtsi / sdm845-wcd9340.dtsi / sdm845-db845c.dts
+ * (same WCD9340 + WSA881x). SM8150/Duo values come from the Duo's own Android device
+ * tree (boot_a dtb #11 "SM8150 v2" + dtbo overlay #31 "Surface Duo DV_A") and the live
+ * Android kernel log -- see docs/research/24-audio.md in this repo.
+ *
+ * Included at the end of arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts by
+ * tools/linux/apply-dts.sh.
+ */
+#include <dt-bindings/clock/qcom,rpmh.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/soc/qcom,apr.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+
+/ {
+	/* Required by the Duo's ABL to pick this DTB (Android dtb: msm-id 0x153 v2, DV_A board-id). */
+	qcom,msm-id = <0x153 0x20000>;
+	qcom,board-id = <0x08 0x10>;
+
+	/*
+	 * Console on the panel. gus's UEFI provides NO GOP/screen_info to the kernel EFI stub, but keeps the
+	 * left panel scanning out its "Display Reserved" buffer (Silicon/QC/Sm8150 PlatformMemoryMapLib:
+	 * 0x80600000, size 0x2400000; reserved in the EFI memory map) at 1350x1800 @ 32bpp (SurfaceDuo1.dsc
+	 * PcdMipiFrameBuffer*). The panel is natively portrait. (Android ABL's splash is at 0x9c000000.)
+	 */
+	reserved-memory {
+		cont_splash_mem: memory@9c000000 {
+			reg = <0x0 0x9c000000 0x0 0x2400000>;
+			no-map;
+		};
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer0: framebuffer@80600000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x80600000 0x0 (1350 * 1800 * 4)>;
+			width = <1350>;
+			height = <1800>;
+			stride = <(1350 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	sound: sound {
+		compatible = "qcom,sdm845-sndcard";
+		model = "Surface-Duo";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		slim-dai-link {
+			link-name = "SLIM Playback";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				/* Android speaker-mono: SLIM RX0 (AIF1_PB) -> RX INT7 -> COMP7 -> SpkrLeft */
+				sound-dai = <&left_spkr>, <&swm 0>, <&wcd9340 0>;
+			};
+		};
+
+	};
+};
+
+&soc {
+	/*
+	 * Software reset: PSCI SYSTEM_RESET hangs on this firmware (reboot -f / sysrq-b froze the kernel).
+	 * Qualcomm boards reset by dropping PMIC PS_HOLD (drivers/power/reset/msm-poweroff.c).
+	 * Android SM8150 DT: restart@c264000 { compatible = "qcom,pshold"; reg = <0xc264000 0x4 ...>; }
+	 */
+	restart@c264000 {
+		compatible = "qcom,pshold";
+		reg = <0 0x0c264000 0 0x4>;
+	};
+
+	/* Android SM8150: slim@171c0000 reg <0x171c0000 0x2c000 0x17184000 0x2c000>, irqs 0xa3/0xa4 */
+	slimbam: dma-controller@17184000 {
+		compatible = "qcom,bam-v1.7.4", "qcom,bam-v1.7.0";
+		qcom,controlled-remotely;
+		reg = <0 0x17184000 0 0x2c000>;
+		num-channels = <31>;	/* sm8150-linux-mainline tested value */
+		interrupts = <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>;
+		#dma-cells = <1>;
+		qcom,ee = <1>;
+		qcom,num-ees = <2>;
+		/* Android lists SIDs 0x1b46/8, 0x1b4d/2, 0x1b50/1; sm8150-linux-mainline uses 0x1b46 alone */
+		iommus = <&apps_smmu 0x1b46 0x0>;
+	};
+
+	slim: slim-ngd@171c0000 {
+		compatible = "qcom,slim-ngd-v2.1.0";
+		reg = <0 0x171c0000 0 0x2c000>;
+		interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
+		dmas = <&slimbam 3>, <&slimbam 4>;
+		dma-names = "rx", "tx";
+		iommus = <&apps_smmu 0x1b46 0x0>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		slim@1 {
+			reg = <1>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+
+			wcd9340_ifd: ifd@0,0 {
+				compatible = "slim217,250";
+				reg = <0 0>;
+			};
+
+			wcd9340: codec@1,0 {
+				compatible = "slim217,250";
+				reg = <1 0>;
+				slim-ifc-dev = <&wcd9340_ifd>;
+				#sound-dai-cells = <1>;
+
+				/* Android wcd9xxx-irq: qcom,gpio-connect = <&tlmm 133>; Linux uses level-high */
+				interrupts-extended = <&tlmm 133 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-controller;
+				#interrupt-cells = <1>;
+				pinctrl-0 = <&wcd_intr_default>;
+				pinctrl-names = "default";
+
+				/* Android msm_cdc_pinctrl@143: qcom,cdc-rst-n-gpio = <&tlmm 143> */
+				reset-gpios = <&tlmm 143 GPIO_ACTIVE_HIGH>;
+
+				/* Android tavil: cdc-vdd-buck/buck-sido/tx-h/rx-h/vddpx-1 = pm8150_s4 (1.8 V) */
+				vdd-buck-supply = <&vreg_s4a_1p8>;
+				vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+				vdd-tx-supply = <&vreg_s4a_1p8>;
+				vdd-rx-supply = <&vreg_s4a_1p8>;
+				vdd-io-supply = <&vreg_s4a_1p8>;
+
+				clock-names = "extclk";
+				clocks = <&rpmhcc RPMH_LN_BB_CLK2>;
+				#clock-cells = <0>;
+				clock-frequency = <9600000>;	/* Android qcom,tavil-mclk-clk-freq = 0x927c00 */
+				clock-output-names = "mclk";
+
+				qcom,micbias1-microvolt = <1800000>;
+				qcom,micbias2-microvolt = <1800000>;
+				qcom,micbias3-microvolt = <1800000>;
+				qcom,micbias4-microvolt = <1800000>;
+
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				wcdgpio: gpio-controller@42 {
+					compatible = "qcom,wcd9340-gpio";
+					gpio-controller;
+					#gpio-cells = <2>;
+					reg = <0x42 0x2>;
+				};
+
+				swm: soundwire@c85 {
+					compatible = "qcom,soundwire-v1.3.0";
+					reg = <0xc85 0x40>;
+					interrupts-extended = <&wcd9340 20>;
+					qcom,dout-ports = <6>;
+					qcom,din-ports = <2>;
+					qcom,ports-sinterval-low = /bits/ 8 <0x07 0x1f 0x3f 0x7 0x1f 0x3f 0x0f 0x0f>;
+					qcom,ports-offset1 = /bits/ 8 <0x01 0x02 0x0c 0x6 0x12 0x0d 0x07 0x0a>;
+					qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x1f 0x00 0x00 0x1f 0x00 0x00>;
+					#sound-dai-cells = <1>;
+					clocks = <&wcd9340>;
+					clock-names = "iface";
+					#address-cells = <2>;
+					#size-cells = <0>;
+
+					/*
+					 * Android: exactly one amp enumerates, wsa881x.21170213 (2117xxxx = WSA8815,
+					 * part 0x2110; unique id 3). SpkrRight does not exist on the Duo.
+					 */
+					left_spkr: speaker@0,3 {
+						compatible = "sdw10217211000";
+						reg = <0 3>;
+						/* Android wsa_en_active: tlmm 142 output-high = enabled; SD_N is active-low */
+						powerdown-gpios = <&tlmm 142 GPIO_ACTIVE_LOW>;
+						#thermal-sensor-cells = <0>;
+						sound-name-prefix = "SpkrLeft";
+						#sound-dai-cells = <0>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&remoteproc_adsp {
+	glink-edge {
+		apr {
+			compatible = "qcom,apr-v2";
+			qcom,glink-channels = "apr_audio_svc";
+			qcom,domain = <APR_DOMAIN_ADSP>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			qcom,intents = <512 20>;
+
+			service@3 {
+				reg = <APR_SVC_ADSP_CORE>;
+				compatible = "qcom,q6core";
+				qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+			};
+
+			q6afe: service@4 {
+				compatible = "qcom,q6afe";
+				reg = <APR_SVC_AFE>;
+				qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+				q6afedai: dais {
+					compatible = "qcom,q6afe-dais";
+					#address-cells = <1>;
+					#size-cells = <0>;
+					#sound-dai-cells = <1>;
+				};
+			};
+
+			q6asm: service@7 {
+				compatible = "qcom,q6asm";
+				reg = <APR_SVC_ASM>;
+				qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+				q6asmdai: dais {
+					compatible = "qcom,q6asm-dais";
+					#address-cells = <1>;
+					#size-cells = <0>;
+					#sound-dai-cells = <1>;
+					/* Android qcom,msm-audio-ion: iommus = <&apps_smmu 0x1b21 0x0> */
+					iommus = <&apps_smmu 0x1b21 0x0>;
+
+					dai@0 {
+						reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+					};
+				};
+			};
+
+			q6adm: service@8 {
+				compatible = "qcom,q6adm";
+				reg = <APR_SVC_ADM>;
+				qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
+				q6routing: routing {
+					compatible = "qcom,q6adm-routing";
+					#sound-dai-cells = <0>;
+				};
+			};
+		};
+	};
+};
+
+&tlmm {
+	wcd_intr_default: wcd-intr-default-state {
+		pins = "gpio133";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camera.dtsi
new file mode 100644
index 000000000..04c0797f3
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camera.dtsi
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: camera step 1 = the CCI (camera I2C) bus, to find the rear/front sensor (docs/research/33 "CAMERA").
+ * From the phone's own DV_A board overlay (dtbo dt31, board-id <8 0x10> = this phone's subtype 16):
+ *   sensor (two second-source entries, same wiring): CSIPHY1, CCI0 master 1, MCLK1 19.2 MHz on gpio14,
+ *   reset gpio30 (CAM_RESET1), power gpio11 (CAM_POWER_GPIO1 = the board's vana 2.8 V / vdig 1.05 V switches),
+ *   vio 1.8 V. CCI0 = 0xac4a000, IRQ SPI 460, pins gpio17/18 (master 0) + gpio19/20 (master 1), 37.5 MHz.
+ * Node layout follows mainline sm8250's cci (same CCI v2). MCLK1 is listed as a CCI clock so it runs while the bus
+ * is up (test only); power + reset are driven from userspace (tools/linux/duo-camera-probe.sh) to keep the order.
+ * camcc-sm8150 + i2c-qcom-cci are modules, loaded by hand with the kernel log streamed (the camera NoC may stall
+ * like the video AXIC did).
+ */
+#include <dt-bindings/clock/qcom,sm8150-camcc.h>
+
+&{/soc@0} {
+	duo_cci0: cci@ac4a000 {
+		compatible = "qcom,sm8250-cci", "qcom,msm8996-cci";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0 0x0ac4a000 0 0x1000>;
+		interrupts = <GIC_SPI 460 IRQ_TYPE_EDGE_RISING>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CCI_0_CLK>,
+			 <&camcc CAM_CC_CCI_0_CLK_SRC>,
+			 <&camcc CAM_CC_MCLK1_CLK>;
+		clock-names = "camnoc_axi", "slow_ahb_src", "cpas_ahb", "cci", "cci_src", "mclk1";
+		assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+				  <&camcc CAM_CC_CCI_0_CLK>,
+				  <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <80000000>, <37500000>, <19200000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&duo_cci0_m0 &duo_cci0_m1 &duo_cam_mclk1>;
+
+		duo_cci0_i2c0: i2c-bus@0 {
+			reg = <0>;
+			clock-frequency = <400000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		duo_cci0_i2c1: i2c-bus@1 {
+			reg = <1>;
+			clock-frequency = <400000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+	};
+};
+
+/* cam_vio (sensor I/O + CCI pull-ups) = PM8150L L1 1.8 V (DV_A __fixups__: pm8150l_l1); Linux left it off and every
+ * master-1 transfer timed out (2026-11-04). Test: keep it on. */
+&vreg_l1c_1p8 {
+	regulator-always-on;
+	regulator-boot-on;
+};
+
+&tlmm {
+	duo_cci0_m0: duo-cci0-m0-state {
+		pins = "gpio17", "gpio18";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	duo_cci0_m1: duo-cci0-m1-state {
+		pins = "gpio19", "gpio20";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	duo_cam_mclk1: duo-cam-mclk1-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss-noiommu.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss-noiommu.dtsi
new file mode 100644
index 000000000..5ad504db4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss-noiommu.dtsi
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Camera test override (step 9, docs/research/33 "CAMERA"): CAMSS without iommus. The VFE completes frames but its
+ * writes never land with the downstream ife bank (0x840 mask 0x620) mapped. Without the mapping the buffers get
+ * physical addresses: either the writes now land (stream passed through), or the SMMU reports a fault that names the
+ * real VFE stream IDs. Test only.
+ */
+
+&duo_camss {
+	/delete-property/ iommus;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss.dtsi
new file mode 100644
index 000000000..89ce772f4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-camss.dtsi
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: CAMSS (camera step 3, docs/research/33 "CAMERA"). SM8150's Titan 175 has the SAME CSID/VFE/CSIPHY
+ * addresses + IRQs as sdm845's Titan 170 (downstream DT: csid175 0xacb3000/IRQ 464, vfe175 0xacaf000/IRQ 465, csid1
+ * 0xacba000, vfe1 0xacb6000, csid-lite 0xacc8000, vfe-lite 0xacc4000, csiphy 0xac65000.. IRQ 477..) -> reuse mainline's
+ * "qcom,sdm845-camss" resources with SM8150 camcc clocks. SM8150 differences: no CAM_CC_SOC_AHB_CLK (CORE_AHB instead),
+ * GCC_CAMERA_HF_AXI_CLK, IFE_LITE_0_*, and the second lite pair / csiphy3 IRQ are left out. IOMMU = downstream
+ * msm_cam_smmu "ife" bank 0x840 mask 0x620 written as its 8 EXACT streams (one masked SMR hung the boot for Venus).
+ * No sensor port yet: this step only checks that CAMSS probes without stalling the camera NoC.
+ */
+
+#include <dt-bindings/interconnect/qcom,sm8150.h>
+
+&{/soc@0} {
+	duo_camss: camss@acb3000 {
+		compatible = "qcom,sm8150-camss";	/* patches/camss-sm8150.py: sdm845 resources + icc votes */
+
+		reg = <0 0x0acb3000 0 0x1000>,
+		      <0 0x0acba000 0 0x1000>,
+		      <0 0x0acc8000 0 0x1000>,
+		      <0 0x0ac65000 0 0x1000>,
+		      <0 0x0ac66000 0 0x1000>,
+		      <0 0x0ac67000 0 0x1000>,
+		      <0 0x0ac68000 0 0x1000>,
