diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-charger.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-charger.dtsi
new file mode 100644
index 000000000..6561c44d8
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-charger.dtsi
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo (1st gen) charger: PM8150B SMB5 via qcom_smbx (+ tools/linux/patches/smb5, upstream series by
+ * Casey Connolly). Interrupts from Microsoft's own DT overlay (dtbo_a, "Surface Duo DV_A", board subtype 0x10):
+ * batif@1200 bat-ov = irq 2, usb@1300 usbin-plugin = 4 / usbin-icl-change = 7, misc@1600 wdog-bark = 1.
+ * Microsoft's limits there: fcc-max 3.7 A, fv-max 4.40 V, usb-icl 3 A, software JEITA from the two bq27742 gauges
+ * (packs 2715 + 750 mAh). The battery node carries Microsoft's maxima (3.0 A = usb-icl, 4.40 V): the driver caps the writable
+ * charge current/voltage at them, and the platform's charge guard (sw-JEITA + step profile from the gauge
+ * temperatures, tools/linux/duo-charger-guard.sh) picks the value inside them; the guard also suspends the USB input
+ * outside 0..45 C (docs/research/33 "Charger"). qcom,sw-jeita-enable = the PMIC's own JEITA stays off (its thermistor
+ * input reads a bogus hot soft limit on the Duo) - Microsoft's downstream DT sets the same property.
+ */
+
+/ {
+	duo_battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <3465000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4300000>;
+		/* qcom_smbx uses this as the wall-charger (DCP) input limit too -> Microsoft's usb-icl 3.0 A, not fcc-max 3.7 A */
+		constant-charge-current-max-microamp = <3000000>;
+		constant-charge-voltage-max-microvolt = <4400000>;
+		charge-term-current-microamp = <150000>;
+	};
+};
+
+&pm8150b_adc {
+	channel@7 {
+		reg = <ADC5_USB_IN_I>;
+		qcom,pre-scaling = <1 1>;
+		label = "usb_in_i_uv";
+	};
+
+	channel@8 {
+		reg = <ADC5_USB_IN_V_16>;
+		qcom,pre-scaling = <1 16>;
+		label = "usb_in_v_div_16";
+	};
+};
+
+&spmi_bus {
+	pmic@2 {
+		pm8150b_charger: charger@1000 {
+			compatible = "qcom,pm8150b-charger";
+			reg = <0x1000>;
+
+			interrupts = <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "usb-plugin",
+					  "bat-ov",
+					  "wdog-bark",
+					  "usbin-icl-change";
+
+			io-channels = <&pm8150b_adc ADC5_USB_IN_I>,
+				      <&pm8150b_adc ADC5_USB_IN_V_16>;
+			io-channel-names = "usbin_i", "usbin_v";
+
+			monitored-battery = <&duo_battery>;
+			qcom,sw-jeita-enable;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-display.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-display.dtsi
new file mode 100644
index 000000000..7ce851558
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-display.dtsi
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1 displays: MDSS/DPU + DSI0 (left, LG "C3") + DSI1 (right, LG "R2"), both 1350x1800
+ * command-mode DSC panels driven by tools/linux/panel/panel-microsoft-surface-duo.c.
+ *
+ * Values from the Duo's Android dtbo #31 (see docs/research/34-display.md):
+ *   C3: reset TLMM 5, TE TLMM 8, vddi = pm8150 S4 (1.8 V)
+ *   R2: reset TLMM 6, TE TLMM 9, vddi = pm8150 S4, vpnl = pm8150 L17 (3.0 V)
+ * DSI controller/PHY supplies as in mainline sm8150-hdk.dts (vdda = L3C 1.2 V, PHY vdds = L5A 0.875 V).
+ * Included from the Duo dts by tools/linux/apply-dts.sh.
+ */
+#include <dt-bindings/gpio/gpio.h>
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3c_1p2>;
+	status = "okay";
+
+	panel_c3: panel@0 {
+		compatible = "microsoft,surface-duo-panel";
+		reg = <0>;
+		reset-gpios = <&tlmm 5 GPIO_ACTIVE_LOW>;
+		vddi-supply = <&vreg_s4a_1p8>;
+		pinctrl-0 = <&panel_c3_default>;
+		pinctrl-names = "default";
+
+		port {
+			panel_c3_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_c3_in>;
+	data-lanes = <0 1 2 3>;
+	qcom,te-source = "mdp_vsync_p";
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p875>;
+	status = "okay";
+};
+
+&mdss_dsi1 {
+	vdda-supply = <&vreg_l3c_1p2>;
+	status = "okay";
+
+	panel_r2: panel@0 {
+		compatible = "microsoft,surface-duo-panel";
+		reg = <0>;
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+		vddi-supply = <&vreg_s4a_1p8>;
+		vpnl-supply = <&vreg_l17a_3p0>;
+		pinctrl-0 = <&panel_r2_default>;
+		pinctrl-names = "default";
+
+		port {
+			panel_r2_in: endpoint {
+				remote-endpoint = <&mdss_dsi1_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi1_out {
+	remote-endpoint = <&panel_r2_in>;
+	data-lanes = <0 1 2 3>;
+	qcom,te-source = "mdp_vsync_s";
+};
+
+&mdss_dsi1_phy {
+	vdds-supply = <&vreg_l5a_0p875>;
+	status = "okay";
+};
+
+&tlmm {
+	panel_c3_default: panel-c3-default-state {
+		reset-pins {
+			pins = "gpio5";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		te-pins {
+			pins = "gpio8";
+			function = "mdp_vsync";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
+
+	panel_r2_default: panel-r2-default-state {
+		reset-pins {
+			pins = "gpio6";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		te-pins {
+			pins = "gpio9";
+			function = "mdp_vsync";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-gpu.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-gpu.dtsi
