@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo (1st gen) GPU: Adreno 640 + GMU, like sm8150-hdk/mtp. Firmware (a630_sqe.fw, a640_gmu.bin and the
+ * a640_zap.mdt zap shader) is linked at boot by init from the phone's own vendor_a partition (docs/research/33 "GPU").
+ * Tested first as a one-shot DT (duo-grub-test.sh DTB=), not in the default DT.
+ */
+
+&gmu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi
new file mode 100644
index 000000000..4b464d87d
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351-bob.dtsi
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Camera test override (step 7, docs/research/33 "CAMERA"): downstream gives the IMX351 cam_bob-supply = PM8150L BOB
+ * at 3.3 V with "pwm-switch" (PWM mode while the camera runs); the board's vana 2.8 V switch is fed from BOB, which
+ * mainline leaves at 3.008 V in AUTO mode. Theory: the pixel array starves (the sensor only sent embedded-data lines).
+ */
+
+&vreg_bob {
+	regulator-min-microvolt = <3296000>;
+	regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351.dtsi
new file mode 100644
index 000000000..91705091f
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-imx351.dtsi
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: the IMX351 sensor on CCI0 master 1 linked to CAMSS csiphy1 (camera step 4, docs/research/33).
+ * Use after sm8150-microsoft-surface-duo-camera.dtsi + -camss.dtsi. The sensor driver (tools/linux/drivers/imx351)
+ * owns MCLK1 now, so the CCI goes back to its own five clocks + pins.
+ */
+#include <dt-bindings/gpio/gpio.h>
+
+&duo_cci0 {
+	clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+		 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+		 <&camcc CAM_CC_CPAS_AHB_CLK>,
+		 <&camcc CAM_CC_CCI_0_CLK>,
+		 <&camcc CAM_CC_CCI_0_CLK_SRC>;
+	clock-names = "camnoc_axi", "slow_ahb_src", "cpas_ahb", "cci", "cci_src";
+	assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>, <&camcc CAM_CC_CCI_0_CLK>;
+	assigned-clock-rates = <80000000>, <37500000>;
+	pinctrl-0 = <&duo_cci0_m0 &duo_cci0_m1>;
+};
+
+&duo_cci0_i2c1 {
+	duo_imx351: camera@1a {
+		compatible = "sony,imx351";
+		reg = <0x1a>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		vio-supply = <&vreg_l1c_1p8>;
+		/* CAM_POWER_GPIO1 switches the module's vana 2.8 V + vdig 1.05 V + the AF vaf 2.8 V: modelled as one
+		 * regulator so the sensor and the lens can both power the module (2026-11-05; power-gpios = old form) */
+		vana-supply = <&duo_cam_module_pwr>;
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;	/* CAM_RESET1 */
+		orientation = <0>;	/* front: the Duo's one camera faces the user when open (Android also uses it as rear by folding) */
+		/* Android's DT (dtbo dt31 qcom,cam-sensor): sensor-position-roll 90 / yaw 180. Verified in Snapshot, phone in
+		 * portrait (2026-11-07): 270 showed the picture upside down, 90 is upright. */
+		rotation = <90>;
+		lens-focus = <&duo_cam_lens>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&duo_cam_mclk1>;
+
+		port {
+			duo_imx351_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <828000000>;
+				remote-endpoint = <&duo_csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&duo_camss {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			duo_csiphy1_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&duo_imx351_ep>;
+			};
+		};
+	};
+};
+
+/* Autofocus (2026-11-05, docs/research/workbench/camera.md): Dongwoon DW9800L on CCI0 master 1 at 0x0c (the CamX
+ * module names "dw9800l_actuator"); mainline dw9719 in its DW9800K mode drives it (focus_absolute 0..1023 verified
+ * against the chip's position registers). Its 2.8 V comes through the module power switch below. */
+&duo_cci0_i2c1 {
+	duo_cam_lens: lens@c {
+		compatible = "dongwoon,dw9800k";
+		reg = <0x0c>;
+		vdd-supply = <&duo_cam_module_pwr>;
+	};
+};
+
+/ {
+	duo_cam_module_pwr: cam-module-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_module_pwr";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <5000>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
new file mode 100644
index 000000000..3126c30b0
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo (SM8150): IPA v4.1 (modem data path) - DRAFT, TEST DTB ONLY.
+ * Needs tools/linux/patches/ipa-v4.1 (compatible "qcom,sm8150-ipa").
+ * Values from the phone's downstream DT (qcom,ipa@1e00000, ipa_smmu_ap/uc, smp2p "ipa"
+ * entries, pil_ipa_fw_region) mapped onto the mainline sc7180/sdm845 node layout.
+ * See docs/research/workbench/ipa-v4.1.md. Firmware: vendor_a /firmware/ipa_fws.*,
+ * linked at boot to /lib/firmware/qcom/sm8150/ (never stored in the repo).
+ */
+
+&{/smp2p-mpss} {
+	ipa_smp2p_out: ipa-ap-to-modem {
+		qcom,entry-name = "ipa";
+		#qcom,smem-state-cells = <1>;
+	};
+
+	ipa_smp2p_in: ipa-modem-to-ap {
+		qcom,entry-name = "ipa";
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
+
+&soc {
+	ipa: ipa@1e40000 {
+		compatible = "qcom,sm8150-ipa";
+
+		/* downstream ipa_smmu_ap (0x520) + ipa_smmu_uc (0x522) */
+		iommus = <&apps_smmu 0x520 0x0>,
+			 <&apps_smmu 0x522 0x0>;
+		/* ipa-base 0x1e00000 + v4.0 reg offset 0x40000; SRAM direct access at +0x7000;
+		 * layout ends at 0x280 + 0x2800 (ipa_4_1_mem_part), hence 0x3000 */
+		reg = <0 0x01e40000 0 0x7000>,
+		      <0 0x01e47000 0 0x3000>,
+		      <0 0x01e04000 0 0x2c000>;
+		reg-names = "ipa-reg",
+			    "ipa-shared",
+			    "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING>,
+				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa",
+				  "gsi",
+				  "ipa-clock-query",
+				  "ipa-setup-ready";
+
+		clocks = <&rpmhcc RPMH_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&aggre2_noc MASTER_IPA 0 &mc_virt SLAVE_EBI_CH0 0>,
+				<&aggre2_noc MASTER_IPA 0 &system_noc SLAVE_OCIMEM 0>,
+				<&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_IPA_CFG 0>;
+		interconnect-names = "memory",
+				     "imem",
+				     "config";
+
+		qcom,qmp = <&aoss_qmp>;
+
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		/* TZ PAS 15 authenticates the GSI firmware the AP loads */
+		qcom,gsi-loader = "self";
+		memory-region = <&ipa_fw_mem>;
+		firmware-name = "qcom/sm8150/ipa_fws.mdt";
+
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-l17a-3v0.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-l17a-3v0.dtsi
new file mode 100644
index 000000000..d00e5011a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-l17a-3v0.dtsi
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: run PM8150 L17A (vpnl of the R2 panel on DSI1 = the camera-side screen) at 3.0 V like Microsoft's
+ * downstream kernel (Droidian regulator dump 2026-11-05: pm8150_l17 enabled 3000000 uV, consumer
+ * soc:qcom,dsi-display-secondary-vpnl). The mainline Duo DT allows 2856000..3008000 and the regulator core settles on
+ * the minimum (2.856 V); that panel's FIRST init fails on most boots (docs/research/33 "Boot panel fault").
+ */
+
+&vreg_l17a_3p0 {
+	regulator-min-microvolt = <3000000>;
+	regulator-max-microvolt = <3008000>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-mic.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-mic.dtsi
new file mode 100644
index 000000000..7c17d79ed
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-mic.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo microphones (2026-11-04, docs/research/33 "Microphones"): WORK (DMIC1 + DMIC2 live, DTB #55 default). The capture DAI link SLIMBUS_0_TX ->
+ * WCD9340 AIF1_CAP + the DMIC bias routing. (A first one-shot boot with the card BUILT IN hung; the card is a module since
+ * kernel #60 and loads fine with this link, by hand and from init.)
+ */
+
+&{/sound} {
+	/* Microsoft's DT (dtbo DV_A): DMIC1 is powered by MIC BIAS1, DMIC2 by MIC BIAS3 (mainline had no routing: the
+	 * DMICs stayed unpowered -> digital silence, rms 0) */
+	audio-routing = "DMIC1", "MIC BIAS1",
+			"DMIC2", "MIC BIAS3";
+
+		/* a second front end (pcm 1,1) so capture and playback can run at once (one ASM session per FE:
+		 * "Audio Client already active" when both used MultiMedia1) - the speaker->mic loopback test */
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		slim-capture-dai-link {
+			/* 2026-11-04: microphones. Android handset-mic = DMIC1 -> DEC7 -> CDC_IF TX7 -> SLIM TX7 (AIF1_CAP)
+			 * -> SLIMBUS_0_TX -> MultiMedia1 (mixer_paths_tavil.xml; tools/linux/duo-mic-test.sh) */
+			link-name = "SLIM Capture";
+			cpu {
+				sound-dai = <&q6afedai SLIMBUS_0_TX>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+
+			codec {
+				sound-dai = <&wcd9340 1>;
+			};
+		};
+};
+
+/* MultiMedia2 front end (capture during playback) needs its own ASM DAI */
+&q6asmdai {
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-usbc.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-usbc.dtsi
new file mode 100644
index 000000000..8ad4a1e2e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-usbc.dtsi
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: USB-C port with DisplayPort alt mode (LOOP.md k; request 2026-11-04: test a Surface USB-C dock with a
+ * PC link + HDMI). Mainline has every piece (pm8150b type-C, QMP USB3/DP combo PHY, msm DP, FSA4480 SBU mux, dwc3 role
+ * switch); the Duo DT just never enabled them. Wiring from the Duo's own downstream overlays (dtbo_a "Surface Duo DV_C",
+ * docs/research/33): FSA4480 at i2c4 (i2c@890000) 0x43 = the DP AUX (SBU) switch, its enable gpio2 held low
+ * ("fsa_usbc_ana_en"); layout modelled on sm8150-hdk.dts (same SoC).
+ * dwc3 stays PERIPHERAL by default so the workbench's USB gadget to the PC (ssh/serial/watchdog) works as before.
+ */
+#include <dt-bindings/usb/pd.h>
+
+&tlmm {
+	duo_fsa_en_default: duo-fsa-en-default-state {
+		pins = "gpio2";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+};
+
+&i2c4 {
+	typec-mux@43 {
+		compatible = "fcs,fsa4480";
+		reg = <0x43>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&duo_fsa_en_default>;
+		mode-switch;
+		orientation-switch;
+
+		port {
+			duo_fsa4480_sbu_mux: endpoint {
+				remote-endpoint = <&duo_typec_sbu_out>;
+			};
+		};
+	};
+};
+
+/* the type-C block's VBUS output (when the phone powers a device); qcom-pmic-typec defers forever without it */
+&pm8150b_vbus {
+	regulator-min-microamp = <500000>;
+	regulator-max-microamp = <3000000>;
+	status = "okay";
+};
+
+&pm8150b_typec {
+	status = "okay";
+	vdd-pdphy-supply = <&vreg_l2a_3p1>;
+
+	connector {
+		compatible = "usb-c-connector";
+		/* a phone: charge from a dock/charger, but can also power a small device */
+		power-role = "dual";
+		try-power-role = "sink";
+		data-role = "dual";
+		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
+		source-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
+		op-sink-microwatt = <10000000>;
+
+		altmodes {
+			displayport {
+				svid = /bits/ 16 <0xff01>;
+				vdo = <0x00001c46>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				duo_typec_hs_in: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				duo_typec_mux_in: endpoint {
+					remote-endpoint = <&usb_1_qmpphy_out>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+				duo_typec_sbu_out: endpoint {
+					remote-endpoint = <&duo_fsa4480_sbu_mux>;
+				};
+			};
+		};
+	};
+};
+
+&usb_1_qmpphy {
+	orientation-switch;
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&duo_typec_mux_in>;
+};
+
+&usb_1_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&duo_typec_hs_in>;
+};
+
+&mdss_dp {
+	status = "okay";
+};
+
+&mdss_dp_out {
+	data-lanes = <0 1>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi
new file mode 100644
index 000000000..f025778e4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus-axicrst.dtsi
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: Venus video codec (IRIS1) for the venus driver patched by patches/venus-sm8150-iris1.py
+ * (docs/research/33 "VENUS PORT SPEC"). Placement, clocks, resets and the IOMMU stream come from the phone's own
+ * downstream DT (qcom,vidc@aa00000, "qcom,sm8150-vidc"); the node layout follows mainline's sm8250 venus.
+ * Firmware: the phone's own modem_a image/venus.mdt, linked at boot to /lib/firmware/qcom/sm8150/microsoft/ by init.
+ * Test only via a one-shot DTB (build-test-dtb.sh) with venus as a module loaded by hand.
+ */
+#include <dt-bindings/clock/qcom,gcc-sm8150.h>
+#include <dt-bindings/clock/qcom,videocc-sm8150.h>
+#include <dt-bindings/interconnect/qcom,sm8150.h>
+#include <dt-bindings/power/qcom-rpmpd.h>
+
+&{/soc@0} {
+	venus: video-codec@aa00000 {
+		compatible = "qcom,sm8150-venus";
+		reg = <0 0x0aa00000 0 0x100000>;
+		interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+
+		power-domains = <&videocc VENUS_GDSC>,
+				<&videocc VCODEC0_GDSC>,
+				<&rpmhpd SM8150_MX>;
+		power-domain-names = "venus", "vcodec0", "mx";
+		operating-points-v2 = <&duo_venus_opp_table>;
+
+		clocks = <&gcc GCC_VIDEO_AXI0_CLK>,
+			 <&videocc VIDEO_CC_MVSC_CORE_CLK>,
+			 <&videocc VIDEO_CC_MVS0_CORE_CLK>,
+			 <&gcc GCC_VIDEO_AXIC_CLK>,
+			 <&gcc GCC_VIDEO_AXI1_CLK>;
+		clock-names = "iface", "core", "vcodec0_core", "axic", "axi1";
+
+		interconnects = <&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_VENUS_CFG 0>,
+				<&mmss_noc MASTER_VIDEO_P0 0 &mc_virt SLAVE_EBI_CH0 0>;
+		interconnect-names = "cpu-cfg", "video-mem";
+
+		/* ONE stream only: downstream's mask 0x60 (0x2300/20/40/60) hard-hung the boot as soon as the SMMU registered
+		 * (2026-11-04) - an SMR overlapping streams the hypervisor/TZ owns; 0x2300 alone boots (iommu group 10) */
+		iommus = <&apps_smmu 0x2300 0x0>;
+		memory-region = <&venus_mem>;
+
+		resets = <&gcc GCC_VIDEO_AXIC_CLK_BCR>,
+			 <&videocc VIDEO_CC_MVSC_CORE_CLK_BCR>;
+		reset-names = "bus", "core";
+
+		firmware-name = "qcom/sm8150/microsoft/venus.mdt";
+
+		duo_venus_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			opp-240000000 {
+				opp-hz = /bits/ 64 <240000000>;
+				required-opps = <&rpmhpd_opp_low_svs>;
+			};
+			opp-338000000 {
+				opp-hz = /bits/ 64 <338000000>;
+				required-opps = <&rpmhpd_opp_svs>;
+			};
+			opp-365000000 {
+				opp-hz = /bits/ 64 <365000000>;
+				required-opps = <&rpmhpd_opp_svs_l1>;
+			};
+			opp-444000000 {
+				opp-hz = /bits/ 64 <444000000>;
+				required-opps = <&rpmhpd_opp_nom>;
+			};
+			opp-533000000 {
+				opp-hz = /bits/ 64 <533000000>;
+				required-opps = <&rpmhpd_opp_turbo>;
+			};
+		};
+
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus.dtsi
new file mode 100644
index 000000000..2686ca6c3
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-venus.dtsi
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1: Venus video codec (IRIS1) for the venus driver patched by patches/venus-sm8150-iris1.py
+ * (docs/research/33 "VENUS PORT SPEC"). Placement, clocks, resets and the IOMMU stream come from the phone's own
+ * downstream DT (qcom,vidc@aa00000, "qcom,sm8150-vidc"); the node layout follows mainline's sm8250 venus.
+ * Firmware: the phone's own modem_a image/venus.mdt, linked at boot to /lib/firmware/qcom/sm8150/microsoft/ by init.
+ * Test only via a one-shot DTB (build-test-dtb.sh) with venus as a module loaded by hand.
+ */
+#include <dt-bindings/clock/qcom,gcc-sm8150.h>
+#include <dt-bindings/clock/qcom,videocc-sm8150.h>
+#include <dt-bindings/interconnect/qcom,sm8150.h>
+#include <dt-bindings/power/qcom-rpmpd.h>
+
+&{/soc@0} {
+	venus: video-codec@aa00000 {
+		compatible = "qcom,sm8150-venus";
+		reg = <0 0x0aa00000 0 0x100000>;	/* 1 MB: downstream maps 2 MB, but 0xab00000 is the videocc device on mainline (-EBUSY) */
+		interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+
+		power-domains = <&videocc VENUS_GDSC>,
+				<&videocc VCODEC0_GDSC>,
+				<&videocc VCODEC1_GDSC>,
+				<&rpmhpd SM8150_MX>;
+		/* vcodec1 = downstream "cvp" supply; powered with the core (patches/venus-sm8150-iris1.py) */
+		power-domain-names = "venus", "vcodec0", "vcodec1", "mx";
+		operating-points-v2 = <&duo_venus_opp_table>;
+
+		clocks = <&gcc GCC_VIDEO_AXI0_CLK>,
+			 <&videocc VIDEO_CC_MVSC_CORE_CLK>,
+			 <&videocc VIDEO_CC_MVS0_CORE_CLK>,
+			 <&gcc GCC_VIDEO_AXIC_CLK>,
+			 <&gcc GCC_VIDEO_AXI1_CLK>,
+			 <&videocc VIDEO_CC_MVS1_CORE_CLK>;
+		/* vcodec1_core = downstream cvp_clk, run together with vcodec0_core (patches/venus-iris1-mvs1.py) */
+		clock-names = "iface", "core", "vcodec0_core", "axic", "axi1", "vcodec1_core";
+
+		interconnects = <&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_VENUS_CFG 0>,
+				<&mmss_noc MASTER_VIDEO_P0 0 &mc_virt SLAVE_EBI_CH0 0>;
+		interconnect-names = "cpu-cfg", "video-mem";
+
+		/* All four non-secure streams of downstream's venus_ns bank (0x2300 mask 0x60), as four EXACT SMRs: the one
+		 * masked SMR hard-hung the boot when the SMMU registered, and 0x2300 alone let the firmware's DMA on
+		 * 0x2320/40/60 stall the MMSS NoC once GCC_VIDEO_AXIC was on (rounds 2-8). VENUS round 9 (2026-11-04): with
+		 * these four the core boots, H.264 decode is bit-exact. */
+		iommus = <&apps_smmu 0x2300 0x0>,
+			 <&apps_smmu 0x2320 0x0>,
+			 <&apps_smmu 0x2340 0x0>,
+			 <&apps_smmu 0x2360 0x0>;
+		memory-region = <&venus_mem>;
+
+		/* downstream (Droidian msm_vidc debug log): video_axi_reset, video_core_reset, video_axi0_reset, video_axi1_reset */
+		resets = <&gcc GCC_VIDEO_AXIC_CLK_BCR>,
+			 <&videocc VIDEO_CC_MVSC_CORE_CLK_BCR>,
+			 <&gcc GCC_VIDEO_AXI0_CLK_BCR>,
+			 <&gcc GCC_VIDEO_AXI1_CLK_BCR>;
+		reset-names = "axic", "core", "axi0", "axi1";
+
+		firmware-name = "qcom/sm8150/microsoft/venus.mdt";
+
+		duo_venus_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			opp-240000000 {
+				opp-hz = /bits/ 64 <240000000>;
+				required-opps = <&rpmhpd_opp_low_svs>;
+			};
+			opp-338000000 {
+				opp-hz = /bits/ 64 <338000000>;
+				required-opps = <&rpmhpd_opp_svs>;
+			};
+			opp-365000000 {
+				opp-hz = /bits/ 64 <365000000>;
+				required-opps = <&rpmhpd_opp_svs_l1>;
+			};
+			opp-444000000 {
+				opp-hz = /bits/ 64 <444000000>;
+				required-opps = <&rpmhpd_opp_nom>;
+			};
+			opp-533000000 {
+				opp-hz = /bits/ 64 <533000000>;
+				required-opps = <&rpmhpd_opp_turbo>;
+			};
+		};
+
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-workbench.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-workbench.dtsi
new file mode 100644
index 000000000..98aad4269
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-workbench.dtsi
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo 1 board fixes for the memory-boot workbench (docs/research/33-linux-workbench.md).
+ *
+ * UFS (Samsung KLUDG4UHDB): at mainline's default HS-Gear 3 the link logs repeated PHY-adapter errors
+ * (pa_err 0x80000001 from ~1 s after boot, saved_uic_err 0x44) and the error handler stalls I/O under load.
+ * Cap the high-speed gear; raise it again once a stress test passes at the higher gear.
+ */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/qcom,rpmh.h>
+
+&ufs_mem_hc {
+	/* HS-G3 rate B like Android (2026-11-04): ~820 MB/s reads, 2 GB fsync write, 0 UFS errors. The old G1 rate-A cap
+	 * (2026-11-02 link errors) was really a rate-A problem: the PHY wants rate B. docs/research/33 "UFS". */
+	limit-hs-gear = <3>;
+	limit-gear-rate = "rate-b";
+};
+
+/*
+ * Touch/pen digitizer: Microsoft HID-over-SPI ("ts_d5") on QUP SE7 SPI (0x89c000), copied from the Duo's Android
+ * dtbo #31 (fragment@44/45, d5_hid@0). The chip speaks the v0.9 protocol (input header version 2), so it needs
+ * Microsoft's own Duo 1 driver (tools/linux/drivers/spi-hid-duo, CONFIG_SPI_HID_DUO), not the upstream 2026
+ * spi-hid series (v1.0 only). That driver toggles reset and power through three pinctrl states:
+ * active = gpio1 up + reset (gpio0) released + IRQ (gpio3) pulled down; sleep = gpio1 down + reset held + IRQ
+ * unbiased; reset = gpio1 up + reset held + IRQ pulled down. The reset states also DRIVE gpio0 (output-low/high):
+ * the UEFI leaves it as an output driven high, so bias alone never reset the chip and it stayed silent.
+ * gpio1 (the chip's power-enable/wake line) is the same: it must be DRIVEN low then high, or after a warm reset
+ * (PS_HOLD, watchdog) the chip never sees a power-on edge and stays silent (2026-11-03).
+ */
+&spi7 {
+	status = "okay";
+
+	touch@0 {
+		compatible = "hid-over-spi";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_HIGH>;
+		vdd-supply = <&vreg_l9a_1p2>;
+		pinctrl-names = "active", "sleep", "reset";
+		pinctrl-0 = <&ts_d5_active>, <&ts_d5_reset_deassert>, <&ts_d5_int_bias>;
+		pinctrl-1 = <&ts_d5_sleep>, <&ts_d5_reset_assert>, <&ts_d5_int_unbias>;
+		pinctrl-2 = <&ts_d5_active>, <&ts_d5_reset_assert>, <&ts_d5_int_bias>;
+		hid-descr-addr = <1>;
+		sleep-timeout-ms = <30000>;
+	};
+};
+
+&tlmm {
+	ts_d5_int_bias: ts-d5-int-bias-state {
+		pins = "gpio3";
+		function = "gpio";
+		bias-pull-down;
+		input-enable;
+	};
+
+	ts_d5_int_unbias: ts-d5-int-unbias-state {
+		pins = "gpio3";
+		function = "gpio";
+		bias-disable;
+		input-enable;
+	};
+
+	ts_d5_active: ts-d5-active-state {
+		pins = "gpio1";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+		output-high;
+	};
+
+	ts_d5_sleep: ts-d5-sleep-state {
+		pins = "gpio1";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+
+	ts_d5_reset_deassert: ts-d5-reset-deassert-state {
+		pins = "gpio0";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+		output-high;
+	};
+
+	ts_d5_reset_assert: ts-d5-reset-assert-state {
+		pins = "gpio0";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+};
+
+/*
+ * Modem (MPSS) for Wi-Fi: the phone's modem_a partition holds split firmware (modem.mdt + modem.bNN), not the
+ * single modem.mbn upstream names; the PAS loader handles .mdt + segments. The initramfs links the partition's
+ * image/ files into /lib/firmware/qcom/sm8150/microsoft/ and starts this remoteproc once they are there.
+ */
+&remoteproc_mpss {
+	firmware-name = "qcom/sm8150/microsoft/modem.mdt";
+};
+
+/*
+ * Wi-Fi experiment (2026-11-03): WLAN firmware crashes with "ccpm_hw_clk.c: CCPM: PLL lock failed". Supplies match
+ * Android (L1A 0.752, L7A 1.8, L2C 1.304), but mainline lets ch0 (L11C) sit at its 3.0 V minimum while Android asks
+ * 3.104-3.312 V. Hold ch0 at 3.3 V.
+ */
+&vreg_l11c_3p3 {
+	regulator-min-microvolt = <3304000>;
+};
+
+/*
+ * Stability experiment (2026-11-03): several hung boots show "da7280 0-004a: Please reload PS_SEQ_ID & mem data",
+ * the da7280 IRQ thread stuck in D state, and an RCU stall on one CPU. Haptics off until that path is understood.
+ */
+&{/soc@0/geniqup@8c0000/i2c@884000/da7280@4a} {
+	/*
+	 * 2026-11-04 retry: enabled, but the driver is a MODULE since kernel #64 (insmod da7280.ko by hand); a kernel with
+	 * it BUILT IN must not boot this DTB (built in it hard-hung the boot twice). Differences to upstream, from
+	 * Microsoft's DT: edge-falling IRQ (a stuck-low SEQ_FAULT line + the threaded ONESHOT handler matched the earlier
+	 * "reload PS_SEQ_ID & mem data" + RCU stall) and the LRA's 190 Hz resonance (upstream 180).
+	 */
+	status = "okay";
+	interrupts-extended = <&tlmm 42 IRQ_TYPE_EDGE_FALLING>;
+	dlg,resonant-freq-hz = <190>;
+};
+
+/*
+ * Wi-Fi: mainline ath10k_snoc only enables its supplies late (after QMI), but the modem's WLAN firmware brings up the
+ * WCN3998 radio as soon as MPSS boots -> "CCPM: PLL lock failed" with the rails off (L11C use count 0 at 3.3 V).
+ * Android's icnss powers them at probe. Keep the four WLAN rails on from boot.
+ */
+&vreg_l1a_0p75 {
+	regulator-always-on;
+};
+
+&vreg_l7a_1p8 {
+	regulator-always-on;
+};
+
+&vreg_l2c_1p3 {
+	regulator-always-on;
+};
+
+&vreg_l11c_3p3 {
+	regulator-always-on;
+};
+
+/*
+ * rmtfs shared memory where the Duo's modem firmware expects it. Downstream allocates it "dynamically" but always at
+ * the same address; Droidian (downstream 4.14) shows uio "rmtfs" at 0xfa601000, size 0x200000 (2026-11-03).
+ * Mainline's fixed 0x89b00000 makes the modem hit memory it is not allowed to (XPU) -> WLAN start crashes.
+ * Same fix as sm8150-mainline's OnePlus 7 (0xf2901000) and Xiaomi nabu (0xfe101000) DTs.
+ */
+/delete-node/ &rmtfs_mem;
+
+/ {
+	reserved-memory {
+		rmtfs_mem: memory@fa601000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0 0xfa601000 0x0 0x200000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <15>;
+		};
+	};
+};
+
+/*
+ * WCN3998 (Wi-Fi + Bluetooth) via the power-sequencing driver (patches/wcn399x-pwrseq: v2 01/05/09 + v3 1-3, from
+ * the SM8150-HDK work). Supplies as Android/Windows use them; the Duo has no WCN enable or sw_ctrl GPIO (Android's
+ * bt_en/cnss pins belong to the unused QCA6390 node) and no ch1 rail. Bluetooth is on QUP SE13 (0xc8c000, Windows
+ * `\_SB.UR18`, HID QCOM0571).
+ */
+/ {
+	wcn3998-pmu {
+		compatible = "qcom,wcn3998-pmu";
+
+		vddio-supply = <&vreg_s4a_1p8>;
+		vddxo-supply = <&vreg_l7a_1p8>;
+		vddrf-supply = <&vreg_l2c_1p3>;
+		vddch0-supply = <&vreg_l11c_3p3>;
+
+		regulators {
+			vreg_pmu_io: ldo0 {
+				regulator-name = "vreg_pmu_io";
+			};
+
+			vreg_pmu_xo: ldo1 {
+				regulator-name = "vreg_pmu_xo";
+			};
+
+			vreg_pmu_rf: ldo2 {
+				regulator-name = "vreg_pmu_rf";
+			};
+
+			vreg_pmu_ch0: ldo3 {
+				regulator-name = "vreg_pmu_ch0";
+			};
+		};
+	};
+};
+
+&wifi {
+	/* Wi-Fi works with upstream's node as-is (2026-11-04): the WLAN fw crash was board data (init drops
+	 * linux-firmware's generic board-2.bin so the phone's own bdwlan.bin is used). Re-tested then: the host-cap skip
+	 * quirk and deleting the RF_CLK2/qdss clocks are NOT needed (DTB #46). Only the supplies below are added. */
+	vdd-1.8-xo-supply = <&vreg_pmu_xo>;
+	vdd-1.3-rfa-supply = <&vreg_pmu_rf>;
+	vdd-3.3-ch0-supply = <&vreg_pmu_ch0>;
+};
+
+&qupv3_id_2 {
+	status = "okay";
+};
+
+&uart13 {
+	/delete-property/ interrupts;
+	interrupts-extended = <&intc GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH>,
+			      <&tlmm 46 IRQ_TYPE_EDGE_FALLING>;
+	pinctrl-0 = <&qup_uart13_default>;
+	pinctrl-1 = <&qup_uart13_sleep>;
+	pinctrl-names = "default", "sleep";
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn3998-bt";
+		/* fixed locally-administered address 02:D0:05:00:00:01 (little-endian); the Duo bootloader fills in none, and
+		 * without one the controller stays "unconfigured" (2026-11-03) */
+		local-bd-address = [ 01 00 00 05 d0 02 ];
+
+		vddio-supply = <&vreg_pmu_io>;
+		vddxo-supply = <&vreg_pmu_xo>;
+		vddrf-supply = <&vreg_pmu_rf>;
+		vddch0-supply = <&vreg_pmu_ch0>;
+
+		max-speed = <3200000>;
+	};
+};
+
+/* Sensors DSP: split firmware from the phone's modem_a partition (image/slpi.mdt + .bNN), linked by the initramfs. */
+&remoteproc_slpi {
+	firmware-name = "qcom/sm8150/microsoft/slpi.mdt";
+};
+
+/*
+ * FastRPC remote heap for the sensors PD, as sdm845.dtsi has it (sensors work there with hexagonrpcd). The
+ * patches/fastrpc fix sends SENSORS_PD message buffers to this pool; without it (sm8150.dtsi has none: "no reserved
+ * DMA memory for FASTRPC") the SLPI got memory outside its address space and the first INIT_ATTACH_SNS froze the whole
+ * SoC — a bus stall the watchdog could not reset (2026-11-03, live kmsg capture).
+ */
+/ {
+	reserved-memory {
+		fastrpc_mem: fastrpc {
+			compatible = "shared-dma-pool";
+			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0x1000000>;
+			reusable;
+		};
+
+		/* pstore/ramoops (2026-11-04): keeps the kernel log + console of a HUNG boot in RAM so the next boot can
+		 * read it from /sys/fs/pstore (hard hangs left no trace so far). 1 MiB inside the UEFI's System RAM block
+		 * 0xa0000000-0xbcbfffff; survival across reset is verified with a marker before relying on it. */
+		ramoops@b0000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xb0000000 0x0 0x100000>;
+			no-map;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x10000>;
+			ecc-size = <16>;
+		};
+	};
+};
+
+&{/soc@0/remoteproc@2400000/glink-edge/fastrpc} {
+	qcom,vmids = <QCOM_SCM_VMID_HLOS QCOM_SCM_VMID_MSS_MSA
+		      QCOM_SCM_VMID_SSC_Q6 QCOM_SCM_VMID_ADSP_Q6>;
+	memory-region = <&fastrpc_mem>;
+};
+
+/* Compute DSP: split firmware from modem_a (image/cdsp.mdt + .bNN), linked by the initramfs; start with duo.cdsp=1. */
+&remoteproc_cdsp {
+	firmware-name = "qcom/sm8150/microsoft/cdsp.mdt";
+};
+
+/* BT UART pins (QUP SE13: gpio43 CTS, 44 RTS, 45 TX, 46 RX) — uart13 has no pinctrl in sm8150.dtsi; without these the
+ * pins are never muxed and every BT command times out (2026-11-03). States copied from the SM8150-HDK WCN399x patch. */
+&tlmm {
+	qup_uart13_default: qup-uart13-default-state {
+		cts-pins {
+			pins = "gpio43";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-bus-hold;
+		};
+
+		rts-pins {
+			pins = "gpio44";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		tx-pins {
+			pins = "gpio45";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rx-pins {
+			pins = "gpio46";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	qup_uart13_sleep: qup-uart13-sleep-state {
+		cts-pins {
+			pins = "gpio43";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-bus-hold;
+		};
+
+		rts-pins {
+			pins = "gpio44";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		tx-pins {
+			pins = "gpio45";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		rx-pins {
+			pins = "gpio46";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
