From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryson <10244083+brysonwf@users.noreply.github.com>
Date: Sat, 7 Nov 2026 18:34:32 -0500
Subject: [PATCH] arm64: dts: qcom: sm8150-microsoft-surface-duo: enable IPA

Describe the IPA v4.1 (modem data path) with the values of the phone's own downstream DT: register
regions, GSI and smp2p interrupts, SMMU streams, interconnects and the self-loaded GSI firmware
(qcom/sm8150/ipa_fws.mdt, read from the phone's vendor partition at boot).

This patch was written by Claude (Anthropic's AI assistant) under the direction of Bryson, who reviewed and
tested it on a Surface Duo.

Signed-off-by: Bryson <10244083+brysonwf@users.noreply.github.com>
---
 .../sm8150-microsoft-surface-duo-ipa.dtsi     | 73 +++++++++++++++++++
 .../dts/qcom/sm8150-microsoft-surface-duo.dts |  1 +
 2 files changed, 74 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi

diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
new file mode 100644
index 000000000..2559a334b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo-ipa.dtsi
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Surface Duo (SM8150): IPA v4.1 (modem data path).
+ * Needs tools/linux/patches/ipa-v4.1 (compatible "qcom,sm8150-ipa").
+ * Values from the phone's downstream DT (qcom,ipa@1e00000, ipa_smmu_ap/uc, smp2p "ipa"
+ * entries, pil_ipa_fw_region) mapped onto the mainline sc7180/sdm845 node layout.
+ * See docs/research/workbench/ipa-v4.1.md. Firmware: vendor_a /firmware/ipa_fws.*,
+ * linked at boot to /lib/firmware/qcom/sm8150/ (never stored in the repo).
+ */
+
+&{/smp2p-mpss} {
+	ipa_smp2p_out: ipa-ap-to-modem {
+		qcom,entry-name = "ipa";
+		#qcom,smem-state-cells = <1>;
+	};
+
+	ipa_smp2p_in: ipa-modem-to-ap {
+		qcom,entry-name = "ipa";
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
+
+&soc {
+	ipa: ipa@1e40000 {
+		compatible = "qcom,sm8150-ipa";
+
+		/* downstream ipa_smmu_ap (0x520) + ipa_smmu_uc (0x522) */
+		iommus = <&apps_smmu 0x520 0x0>,
+			 <&apps_smmu 0x522 0x0>;
+		/* ipa-base 0x1e00000 + v4.0 reg offset 0x40000; SRAM direct access at +0x7000;
+		 * layout ends at 0x280 + 0x2800 (ipa_4_1_mem_part), hence 0x3000 */
+		reg = <0 0x01e40000 0 0x7000>,
+		      <0 0x01e47000 0 0x3000>,
+		      <0 0x01e04000 0 0x2c000>;
+		reg-names = "ipa-reg",
+			    "ipa-shared",
+			    "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING>,
+				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa",
+				  "gsi",
+				  "ipa-clock-query",
+				  "ipa-setup-ready";
+
+		clocks = <&rpmhcc RPMH_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&aggre2_noc MASTER_IPA 0 &mc_virt SLAVE_EBI_CH0 0>,
+				<&aggre2_noc MASTER_IPA 0 &system_noc SLAVE_OCIMEM 0>,
+				<&gem_noc MASTER_AMPSS_M0 0 &config_noc SLAVE_IPA_CFG 0>;
+		interconnect-names = "memory",
+				     "imem",
+				     "config";
+
+		qcom,qmp = <&aoss_qmp>;
+
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		/* TZ PAS 15 authenticates the GSI firmware the AP loads */
+		qcom,gsi-loader = "self";
+		memory-region = <&ipa_fw_mem>;
+		firmware-name = "qcom/sm8150/ipa_fws.mdt";
+
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts
index a884aca5b..19cc46213 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts
@@ -571,3 +571,4 @@ &wifi {
 #include "sm8150-microsoft-surface-duo-venus.dtsi"
 #include "sm8150-microsoft-surface-duo-flash.dtsi"
 #include "sm8150-microsoft-surface-duo-thermal.dtsi"
+#include "sm8150-microsoft-surface-duo-ipa.dtsi"
