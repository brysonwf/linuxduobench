From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryson <10244083+brysonwf@users.noreply.github.com>
Date: Sat, 7 Nov 2026 09:55:47 -0500
Subject: [PATCH] drm/panel: add Microsoft Surface Duo panels

The two 1350x1800 LG AMOLED command-mode panels of the Surface Duo (SW43416, DSC 1.1, 2 slices), each on its own
DSI link. The init sequences and DSC parameters come from the panel tables in the device's ACPI (_ROM). The panels
need all DSC slices of a line in one packet and command-mode burst off.

This patch was written by Claude (Anthropic's AI assistant) under the direction of Bryson, who reviewed and
tested it on a Surface Duo.

Signed-off-by: Bryson <10244083+brysonwf@users.noreply.github.com>
---
 drivers/gpu/drm/panel/Kconfig                 |   8 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../drm/panel/panel-microsoft-surface-duo.c   | 362 ++++++++++++++++++
 3 files changed, 371 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-microsoft-surface-duo.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 7a83804fe..abc59eab0 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1210,4 +1210,12 @@ config DRM_PANEL_XINPENG_XPP055C272
 	  Say Y here if you want to enable support for the Xinpeng
 	  XPP055C272 controller for 720x1280 LCD panels with MIPI/RGB/SPI
 	  system interfaces.
+config DRM_PANEL_MICROSOFT_SURFACE_DUO
+	tristate "Microsoft Surface Duo 1 LG AMOLED DSC command-mode panels"
+	depends on OF && DRM_MIPI_DSI && BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Both 1350x1800 panels of the Surface Duo 1 (LG C3 on DSI0, R2 on DSI1).
+
 endmenu
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index b9562a6fd..4d8f74228 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -120,3 +120,4 @@ obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130) += panel-visionox-vtdr6130.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
+obj-$(CONFIG_DRM_PANEL_MICROSOFT_SURFACE_DUO) += panel-microsoft-surface-duo.o
diff --git a/drivers/gpu/drm/panel/panel-microsoft-surface-duo.c b/drivers/gpu/drm/panel/panel-microsoft-surface-duo.c
new file mode 100644
index 000000000..982e073a8
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-microsoft-surface-duo.c
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Microsoft Surface Duo panels: two LG AMOLED 1350x1800 command-mode DSI panels
+ * with DSC 1.1, one per DSI host.
+ *
+ * Init sequences, PPS and timings are taken from the Surface Duo's Android device
+ * tree (qcom,mdss_dsi_panel_lg_v2_amoled_cmd_{c3,r2}_dv; both panels use the same
+ * sequence).
+ * The command order follows panel-lg-sw43408 (same LG command family).
+ */
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+struct duo_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[2];
+	struct drm_dsc_config dsc;
+	bool first_prepared;
+};
+
+static inline struct duo_panel *to_duo_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct duo_panel, panel);
+}
+
+/* The PPS the panel receives under Android (DSC 1.1, 8 bpc / 8 bpp, two 675x900 slices). */
+static const u8 duo_pps[128] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x07, 0x08, 0x05, 0x46, 0x03, 0x84,
+	0x02, 0xa3, 0x02, 0xa3, 0x02, 0x00, 0x02, 0x51, 0x00, 0x20, 0x5f, 0x4b,
+	0x00, 0x09, 0x00, 0x0c, 0x00, 0x1c, 0x00, 0x18, 0x18, 0x00, 0x10, 0xf0,
+	0x03, 0x0c, 0x20, 0x00, 0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b, 0x7d, 0x7e, 0x01, 0x02,
+	0x01, 0x00, 0x09, 0x40, 0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6, 0x2b, 0x34, 0x2b, 0x74,
+	0x3b, 0x74, 0x6b, 0xf4,
+};
+
+static void duo_panel_reset(struct duo_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(40);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int duo_panel_on(struct duo_panel *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xac);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2a, 0x00, 0x00, 0x05, 0x45);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2b, 0x00, 0x00, 0x07, 0x07);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x26, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x44, 0x03, 0x84);	/* tear scanline 900 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x51, 0x01, 0x47);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x0c, 0x30);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x04, 0x70, 0xdb, 0x00, 0x78, 0xdb);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xee, 0x24);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0xac);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xca);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 90);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xac);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe9, 0x32, 0x32, 0x55, 0x06, 0x00, 0x1c, 0x00, 0x00,
+				     0x55, 0x50, 0x4b);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd0, 0x80, 0x10, 0x81, 0x02, 0x0b, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x0c, 0x00, 0xd4,
+				     0x0b, 0x00, 0x11, 0x00, 0x1c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xca);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x53, 0x0d, 0x30);
+
+	/*
+	 * As in panel-lg-sw43408: the PPS in HS mode, then compression mode
+	 * (PPS table 1, like Android).
+	 */
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx,
+					     (const struct drm_dsc_picture_parameter_set *)duo_pps);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_compression_mode_ext_multi(&dsi_ctx, true, MIPI_DSI_COMPRESSION_DSC, 1);
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	return dsi_ctx.accum_err;
+}
+
+static int duo_panel_off(struct duo_panel *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 1);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	return dsi_ctx.accum_err;
+}
+
+static int duo_panel_prepare(struct drm_panel *panel)
+{
+	struct duo_panel *ctx = to_duo_panel(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+	msleep(20);
+
+	/*
+	 * The bootloader only brings up the first DSI link. The second panel's first init commands
+	 * were lost on most boots unless its freshly powered link was given time to settle.
+	 */
+	if (!ctx->first_prepared) {
+		msleep(300);
+		ctx->first_prepared = true;
+	}
+
+	duo_panel_reset(ctx);
+
+	ret = duo_panel_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+	return 0;
+}
+
+static int duo_panel_enable(struct drm_panel *panel)
+{
+	/*
+	 * prepare() resets the panel, which returns its brightness register to the reset value,
+	 * while the backlight core only writes the brightness when it changes: send it again.
+	 */
+	if (panel->backlight)
+		backlight_update_status(panel->backlight);
+	return 0;
+}
+
+static int duo_panel_unprepare(struct drm_panel *panel)
+{
+	struct duo_panel *ctx = to_duo_panel(panel);
+
+	duo_panel_off(ctx);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	return 0;
+}
+
+/*
+ * Command mode: the porches only size the DSI link clock. The back porch of 552 gives
+ * ~700 Mbit/s per lane, the rate Android uses; with the panel's nominal 20 the link was too
+ * slow to transfer a frame within 1/60 s.
+ */
+static const struct drm_display_mode duo_panel_mode = {
+	.clock = (1350 + 20 + 32 + 552) * (1800 + 20 + 4 + 20) * 60 / 1000,
+	.hdisplay = 1350,
+	.hsync_start = 1350 + 20,
+	.hsync_end = 1350 + 20 + 32,
+	.htotal = 1350 + 20 + 32 + 552,
+	.vdisplay = 1800,
+	.vsync_start = 1800 + 20,
+	.vsync_end = 1800 + 20 + 4,
+	.vtotal = 1800 + 20 + 4 + 20,
+	.width_mm = 85,
+	.height_mm = 114,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+/*
+ * A minimal EDID 1.4 for each panel (the DSI panels have none): manufacturer "LGD", product name "Surface Duo"
+ * and, as serial, the DSI host's device name (different per panel). Wayland compositors identify outputs by
+ * EDID make/model/serial; without it both panels read (null)/(null)/(null) and no touchscreen-to-output mapping
+ * (phoc/Mutter gsettings, KWin) can tell them apart (2026-11-06). Modes still come from the fixed mode below.
+ */
+static void duo_panel_text_desc(u8 *d, u8 tag, const char *s)
+{
+	int i;
+
+	memset(d, 0, 18);
+	d[3] = tag;
+	for (i = 0; i < 13 && s[i]; i++)	/* up to 13 chars, then LF, then spaces */
+		d[5 + i] = s[i];
+	if (i < 13) {
+		d[5 + i] = 0x0a;
+		memset(&d[6 + i], 0x20, 12 - i);
+	}
+}
+
+static void duo_panel_set_edid(struct duo_panel *ctx, struct drm_connector *connector)
+{
+	const struct drm_edid *drm_edid;
+	u8 e[EDID_LENGTH] = { 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00 };
+	u8 sum = 0;
+	int i;
+
+	e[8] = 0x30; e[9] = 0xe4;		/* "LGD" = LG Display, the panels' maker ("MSF" is M-Systems) */
+	e[10] = 0x01;				/* product code */
+	e[17] = 2019 - 1990;			/* model year */
+	e[18] = 1; e[19] = 4;			/* EDID 1.4 */
+	e[20] = 0xa5;				/* digital, 8 bpc */
+	e[21] = 9; e[22] = 11;			/* 85 x 114 mm, in cm */
+	e[23] = 0x78;				/* gamma 2.2 */
+	for (i = 38; i < 54; i++)		/* no standard timings */
+		e[i] = 0x01;
+	duo_panel_text_desc(&e[54], 0xfc, "Surface Duo");
+	duo_panel_text_desc(&e[72], 0xff, dev_name(ctx->dsi->host->dev));
+	duo_panel_text_desc(&e[90], 0x10, "");
+	duo_panel_text_desc(&e[108], 0x10, "");
+	for (i = 0; i < EDID_LENGTH - 1; i++)
+		sum += e[i];
+	e[EDID_LENGTH - 1] = 0x100 - sum;
+
+	drm_edid = drm_edid_alloc(e, sizeof(e));
+	drm_edid_connector_update(connector, drm_edid);
+	drm_edid_free(drm_edid);
+}
+
+static int duo_panel_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	duo_panel_set_edid(container_of(panel, struct duo_panel, panel), connector);
+	return drm_connector_helper_get_modes_fixed(connector, &duo_panel_mode);
+}
+
+static const struct drm_panel_funcs duo_panel_funcs = {
+	.prepare = duo_panel_prepare,
+	.unprepare = duo_panel_unprepare,
+	.enable = duo_panel_enable,
+	.get_modes = duo_panel_get_modes,
+};
+
+static int duo_panel_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	return ret;
+}
+
+static const struct backlight_ops duo_panel_bl_ops = {
+	.update_status = duo_panel_bl_update_status,
+};
+
+static int duo_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 327,
+		.max_brightness = 1023,
+	};
+	struct duo_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct duo_panel, panel, &duo_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vddi";
+	ctx->supplies[1].supply = "vpnl";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "failed to get reset-gpios\n");
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 900;
+	ctx->dsc.slice_width = 675;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	ctx->dsc.convert_rgb = true;
+	ctx->dsc.line_buf_depth = 9;
+	dsi->dsc = &ctx->dsc;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS |
+			  MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT | MIPI_DSI_MODE_NO_CMD_BURST;
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+							      &duo_panel_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+	}
+	return ret;
+}
+
+static void duo_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct duo_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id duo_panel_of_match[] = {
+	{ .compatible = "microsoft,surface-duo-panel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, duo_panel_of_match);
+
+static struct mipi_dsi_driver duo_panel_driver = {
+	.probe = duo_panel_probe,
+	.remove = duo_panel_remove,
+	.driver = {
+		.name = "panel-microsoft-surface-duo",
+		.of_match_table = duo_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(duo_panel_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Microsoft Surface Duo LG AMOLED DSC panels");
+MODULE_LICENSE("GPL");
