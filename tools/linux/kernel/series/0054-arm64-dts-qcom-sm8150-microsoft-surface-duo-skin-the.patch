--- a/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-microsoft-surface-duo.dts
@@ -554,3 +554,4 @@ &wifi {
 #include "sm8150-microsoft-surface-duo-usbc.dtsi"
 #include "sm8150-microsoft-surface-duo-venus.dtsi"
 #include "sm8150-microsoft-surface-duo-flash.dtsi"
+#include "sm8150-microsoft-surface-duo-thermal.dtsi"
