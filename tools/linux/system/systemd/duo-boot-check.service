# Self-recovery gate (started by duo-boot-check.timer 2 min after boot): this boot only counts as good - the slot is
# marked successful - once duo-slot check passes. A slot that never passes falls back to stock Android after 7 boots.
# (qbootctl's own qbootctl.service, which marks the slot as soon as multi-user is reached, is masked.)
[Unit]
Description=Surface Duo: health check, then mark the boot slot good
After=duo-hw.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/duo/duo-slot check
ExecStart=/usr/libexec/duo/duo-slot good
TimeoutStartSec=300
